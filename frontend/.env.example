# Copy this file to .env.local (git-ignored) and fill in the values.
# Local values come from running `npx supabase status` in backend/.
VITE_API_URL=http://127.0.0.1:54321/functions/v1/api
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
# The "I'm not a robot" check on Register (Cloudflare Turnstile). Empty = no
# widget. Cloudflare's test key, which always passes: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
