ALLOWED_ORIGINS=http://localhost:5173
# Error monitoring. Leave SENTRY_DSN empty locally (reporting stays off);
# staging and production set both as Supabase secrets.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
# The "I'm not a robot" check on Register (Cloudflare Turnstile). Empty = off.
# To try it locally, use Cloudflare's test secret, which accepts any token:
# 1x0000000000000000000000000000000AA (the frontend then needs the test site
# key 1x00000000000000000000AA in VITE_TURNSTILE_SITE_KEY).
TURNSTILE_SECRET_KEY=
