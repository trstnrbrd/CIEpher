{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "allow",
      "*backend/*": "deny",
      "*frontend/src/api/*": "deny",
      "*.github/*": "deny",
      "*backups/*": "deny",
      "*Documents/*": "deny",
      "*AGENTS.md": "deny",
      "*opencode.json": "deny",
      "*CLAUDE.md": "deny"
    },
    "bash": {
      "*": "allow",
      "*backend*": "ask",
      "*frontend/src/api*": "ask",
      "gh *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask",
      "git reset *": "ask",
      "git clean *": "ask",
      "git cherry-pick *": "ask",
      "git branch -d *": "ask",
      "git push *": "deny",
      "git -* push *": "deny",
      "git push * feat/fe-*": "ask",
      "git push * fix/fe-*": "ask",
      "git push * develop *": "deny",
      "git push * main *": "deny",
      "git push *:develop *": "deny",
      "git push *:main *": "deny",
      "git push *--force*": "deny",
      "git push -f *": "deny",
      "git push * -f *": "deny",
      "git push *+*": "deny",
      "git push *--delete*": "deny",
      "git push -d *": "deny",
      "git push * -d *": "deny",
      "git push :*": "deny",
      "git push * :*": "deny",
      "git push *--all*": "deny",
      "git push *--mirror*": "deny"
    }
  }
}
